# Copy this file to .env for local Docker configuration.
DB_NAME=omnispace
DB_USER=omnispace
DB_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=3000

# Use a randomly generated value of at least 32 bytes outside local development.
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-bytes

# HTTPS deployments should use true. SameSite=None is deliberately unsupported
# because it requires a separate CSRF-token design.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_CONCURRENCY_WINDOW_SECONDS=5

# Exact comma-separated browser origins; wildcards are not accepted.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
VITE_API_URL=http://localhost:8081

CURRENT_ACADEMIC_YEAR=2025-2026
CURRENT_SEMESTER=Fall
